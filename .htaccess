# UFAvia — Apache конфигурация для OpenServer Panel
AddDefaultCharset UTF-8

# Приоритет индексного файла: index.php всегда первый
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Если запрашивается существующий статический ресурс (css, js, картинки, шрифты) — отдаем напрямую
  RewriteCond %{REQUEST_URI} \.(css|js|svg|png|jpg|jpeg|gif|woff|woff2|ttf|ico|map|txt|sql)$ [NC]
  RewriteRule ^ - [L]

  # 2. Автоматический редирект с любых *.html запросов на *.php
  RewriteRule ^pages/(.*)\.html$ pages/$1.php [R=301,L,QSA]
  RewriteRule ^(.*)\.html$ $1.php [R=301,L,QSA]

  # 3. Маршруты без расширения
  RewriteRule ^cart/?$ pages/cart.php [L,QSA]
  RewriteRule ^search/?$ pages/search.php [L,QSA]
  RewriteRule ^tickets/?$ pages/tickets.php [L,QSA]
  RewriteRule ^order/?$ pages/order.php [L,QSA]
  RewriteRule ^checkout/?$ pages/checkout.php [L,QSA]
  RewriteRule ^profile/?$ pages/profile.php [L,QSA]
  RewriteRule ^admin/?$ pages/admin.php [L,QSA]
  RewriteRule ^login/?$ pages/login.php [L,QSA]
  RewriteRule ^logout/?$ pages/logout.php [L,QSA]
</IfModule>
